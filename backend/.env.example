# Banco de dados (MySQL local ou container mapeado na máquina)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sync_day_db
DB_USER=root
DB_PASSWORD=trocar_por_senha_segura
DB_DIALECT=mysql
# MySQL gerenciado (Aiven e TiDB) exige TLS — true em produção
DB_SSL=false

# Servidor
PORT=3001
NODE_ENV=development

# Autenticação
JWT_SECRET=trocar_por_segredo_jwt
JWT_EXPIRES_IN=1d

# CORS — origem do frontend
FRONTEND_URL=http://localhost:5173
